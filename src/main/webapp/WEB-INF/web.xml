<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Smart Bus Ticketing - Member C</display-name>

    <!-- ============================================================ -->
    <!-- Database Configuration (Context Params)                      -->
    <!-- ============================================================ -->
    <context-param>
        <param-name>DB_URL</param-name>
        <param-value>jdbc:mysql://localhost:3306/smart_bus_ticketing?useSSL=false&amp;serverTimezone=Asia/Ho_Chi_Minh&amp;allowPublicKeyRetrieval=true&amp;characterEncoding=UTF-8</param-value>
    </context-param>
    <context-param>
        <param-name>DB_USER</param-name>
        <param-value>root</param-value>
    </context-param>
    <context-param>
        <param-name>DB_PASSWORD</param-name>
        <param-value>root</param-value>
    </context-param>
    <context-param>
        <param-name>UPLOAD_DIR</param-name>
        <param-value>uploads</param-value>
    </context-param>

    <!-- ============================================================ -->
    <!-- Servlets                                                      -->
    <!-- ============================================================ -->

    <!-- Index / Dashboard -->
    <servlet>
        <servlet-name>IndexServlet</servlet-name>
        <servlet-class>com.smartbus.servlet.IndexServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>IndexServlet</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>

    <!-- Admin: Audit Log -->
    <servlet>
        <servlet-name>AuditLogServlet</servlet-name>
        <servlet-class>com.smartbus.servlet.AuditLogServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuditLogServlet</servlet-name>
        <url-pattern>/admin/audit-log</url-pattern>
    </servlet-mapping>

    <!-- Passenger: Submit Feedback -->
    <servlet>
        <servlet-name>FeedbackFormServlet</servlet-name>
        <servlet-class>com.smartbus.servlet.FeedbackFormServlet</servlet-class>
        <multipart-config>
            <max-file-size>5242880</max-file-size>         <!-- 5MB -->
            <max-request-size>10485760</max-request-size>  <!-- 10MB -->
            <file-size-threshold>1048576</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>FeedbackFormServlet</servlet-name>
        <url-pattern>/feedback/submit</url-pattern>
    </servlet-mapping>

    <!-- Admin: Manage Feedbacks -->
    <servlet>
        <servlet-name>FeedbackManageServlet</servlet-name>
        <servlet-class>com.smartbus.servlet.FeedbackManageServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FeedbackManageServlet</servlet-name>
        <url-pattern>/admin/feedbacks</url-pattern>
    </servlet-mapping>

    <!-- Admin: Feedback Detail -->
    <servlet>
        <servlet-name>FeedbackDetailServlet</servlet-name>
        <servlet-class>com.smartbus.servlet.FeedbackDetailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FeedbackDetailServlet</servlet-name>
        <url-pattern>/admin/feedback-detail</url-pattern>
    </servlet-mapping>

    <!-- Admin: Update Feedback Status (AJAX) -->
    <servlet>
        <servlet-name>FeedbackStatusServlet</servlet-name>
        <servlet-class>com.smartbus.servlet.FeedbackStatusServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FeedbackStatusServlet</servlet-name>
        <url-pattern>/admin/feedback-status</url-pattern>
    </servlet-mapping>

    <!-- ============================================================ -->
    <!-- Error Pages                                                   -->
    <!-- ============================================================ -->
    <error-page>
        <error-code>404</error-code>
        <location>/views/error/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/views/error/500.jsp</location>
    </error-page>

    <!-- ============================================================ -->
    <!-- Session Config                                                -->
    <!-- ============================================================ -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
